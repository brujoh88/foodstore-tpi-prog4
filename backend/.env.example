# Copiar a .env y ajustar. El .env no se sube al repositorio.

# PostgreSQL (con el docker-compose.yml de esta carpeta: usuario foodstore, clave foodstore).
DATABASE_URL=postgresql://foodstore:foodstore@localhost:5432/foodstore_db
# Para probar sin PostgreSQL:
# DATABASE_URL=sqlite:///./foodstore.db

# Firma del JWT: mínimo 32 caracteres. Generar una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (con credenciales).
FRONTEND_ORIGIN=http://localhost:5173

# true solo si la API se sirve por HTTPS.
COOKIE_SECURE=false
